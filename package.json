{
  "name": "lf-auth-be",
  "version": "1.0.0",
  "description": "LynkFlow authentication microservice",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "dev": "nodemon --watch index.ts --watch app.ts --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "db:migrate": "npm run build && npm run db:migrate:production",
    "db:migrate:production": "node dist/scripts/migrate.js",
    "pretest": "npm run db:migrate",
    "test": "npm run build:test && node --test --test-concurrency=1 dist-test/test/auth.login.test.js dist-test/test/auth.activation.test.js dist-test/test/auth.password.test.js dist-test/test/auth.signup.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "typescript": "7.0.2"
  }
}
