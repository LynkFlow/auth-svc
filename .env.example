DATABASE_URL=postgresql://app_user:percent_encoded_password@localhost:5432/LynkFlow
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with credentials.
# 3001 is scratch-test-ui's dev port, 3002 is auth-ui's -- add any other
# *-ui dev port that needs to call this service locally.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
REFRESH_COOKIE_NAME=lf.refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
TRUST_PROXY=false
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt-public.pem
JWT_KEY_ID=lf-auth-rs256-v1
JWT_ISSUER=lynkflow-auth
JWT_AUDIENCE=lynkflow-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_CLOCK_TOLERANCE_SECONDS=5
EMAIL_SERVICE_URL=http://localhost:3010/api/v1/emails/send
EMAIL_LOCALE=en
EMAIL_OUTBOX_POLL_INTERVAL_MS=2000
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_MAX_ATTEMPTS=10
EMAIL_OUTBOX_LOCK_TIMEOUT_SECONDS=60
EMAIL_SERVICE_TIMEOUT_MS=10000
