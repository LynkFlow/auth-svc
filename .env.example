DATABASE_URL=postgresql://app_user:percent_encoded_password@localhost:5432/LynkFlow
PORT=3000
NODE_ENV=development
REFRESH_COOKIE_NAME=lf.refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
TRUST_PROXY=false
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt-public.pem
JWT_KEY_ID=lf-auth-rs256-v1
JWT_ISSUER=lynkflow-auth
JWT_AUDIENCE=lynkflow-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_CLOCK_TOLERANCE_SECONDS=5
