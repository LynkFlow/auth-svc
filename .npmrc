# --- Registry: REMOTE (default) ---
# The real, published home for every @lynkflow/* package.
@lynkflow:registry=https://npm.pkg.github.com

# Token as an environment variable, never a literal value in this file.
# Set LYNKFLOW_NPM_TOKEN once in your shell profile (a classic GitHub PAT --
# read:packages to install, write:packages to publish -- see publishing.md)
# and every repo's install/publish picks it up automatically. This line is
# safe to commit: it's a reference to a variable name, not a secret.
//npm.pkg.github.com/:_authToken=${LYNKFLOW_NPM_TOKEN}
